<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_ros2_bridge</name>
  <version>0.1.0</version>
  <description>
    Bridge between Unitree G1 native DDS topics (rt/lowstate, rt/sportmodestate)
    and standard ROS2 interfaces (sensor_msgs/Imu, sensor_msgs/JointState,
    nav_msgs/Odometry, geometry_msgs/Twist). Tested on ROS2 Foxy.
  </description>
  <maintainer email="simonroy505@gmail.com">simonroy</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
